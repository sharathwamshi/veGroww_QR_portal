# =====================================================================
# QR Saathi (powered by Akruthi India) - environment configuration
# Copy this file to `.env` (same folder as config.py) and edit values.
#   cp .env.example .env
# Never commit the real .env to git.
# =====================================================================

# ---------- Flask ----------
# SECRET_KEY signs sign-in sessions: use a long random value, e.g. the
# output of:  python -c "import secrets; print(secrets.token_hex(32))"
# Set SESSION_COOKIE_SECURE=1 once the portal is served only over https.
SECRET_KEY=change-this-to-a-long-random-string
SESSION_COOKIE_SECURE=0
REMEMBER_ME_DAYS=30
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ---------- MySQL ----------
DB_USER=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vegroww_qr_portal
DB_POOL_RECYCLE=280

# Optional: set a full DSN and it overrides all the DB_* values above.
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/vegroww_qr_portal?charset=utf8mb4

# Set to 0 once you have imported schema.sql, so the app skips db.create_all()
AUTO_CREATE_TABLES=1

# ---------- Admin account (used ONCE) ----------
# On first start-up, if there's no admin account in the database yet, one
# is created with these credentials. After that the password lives (hashed)
# in the database: change it from My account -> Password. Editing these
# values later has no effect on the existing admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vegroww@123

# ---------- Storage / uploads ----------
# Leave blank to use qr_id_portal/static/uploads
UPLOAD_ROOT=
MAX_UPLOAD_MB=30
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,webp
ALLOWED_DATA_EXTENSIONS=csv,xlsx,xls
ALLOWED_ARCHIVE_EXTENSIONS=zip

# ---------- Public URL / QR shortening ----------
PUBLIC_BASE_URL=http://127.0.0.1:5000
TINYURL_API=https://tinyurl.com/api-create.php
TINYURL_TIMEOUT=5

# ---------- Branding ----------
APP_NAME=QR Saathi
APP_TAGLINE=Powered by Akruthi India
